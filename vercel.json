{
  "headers": [
    {
      "source": "/(conferences_imgs|speakers_imgs|gallery_imgs|images|magazines|commitee_members|assets)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
